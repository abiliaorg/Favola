<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GazeBridge</RootNamespace>
    <AssemblyName>GazeBridge</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    To enable the real Tobii Eye Tracker 5 source:
    1. Download "Tobii Game Integration SDK" from developer.tobii.com.
    2. Add a Reference to Tobii.GameIntegration.Net.dll from that SDK, e.g.:
         <ItemGroup>
           <Reference Include="Tobii.GameIntegration.Net">
             <HintPath>C:\path\to\TobiiSDK\Tobii.GameIntegration.Net.dll</HintPath>
           </Reference>
         </ItemGroup>
    3. Copy the native tobii_gameintegration_x64.dll next to the build output.
    4. Uncomment the body of TobiiGazeSource.cs.
  -->

</Project>
